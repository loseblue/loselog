<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Loselog log viewer</title>
    <license file="COPYING"/>
    <welcome file="description.txt"/>
    
    <pkg-ref id="com.github.variar.loselog"/>
    <options customize="never" require-scripts="false"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.github.variar.loselog"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.github.variar.loselog" visible="false">
        <pkg-ref id="com.github.variar.loselog"/>
    </choice>
    <pkg-ref id="com.github.variar.loselog" version="%loselog_version%" onConclusion="none">%loselog_pkg%</pkg-ref>
</installer-gui-script>
